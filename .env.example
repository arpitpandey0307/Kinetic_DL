# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Number of reverse proxies in front of the app (Render/Railway: 1). Needed so
# rate limiting sees real client IPs. Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=0
# Comma-separated origins allowed to call the API cross-origin. Leave empty for
# same-origin only (the bundled UI does not need CORS).
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# External tools
# ---------------------------------------------------------------------------
YTDLP_PATH=yt-dlp
# ffmpeg binary or the folder containing it. Empty = use ffmpeg from PATH.
FFMPEG_LOCATION=
# JavaScript runtime(s) yt-dlp may use for YouTube (comma-separated: node, deno)
YTDLP_JS_RUNTIMES=node
# Optional cookies for sites that block anonymous/datacenter traffic.
# Either a path to a Netscape-format cookies.txt ...
YTDLP_COOKIES_FILE=
# ... or the file's raw content (handy for hosting dashboards)
YTDLP_COOKIES=
# Optional logged-in TeraBox cookie ("ndus=..." or just its value).
# Without it TeraBox only allows short previews of most videos.
TERABOX_COOKIE=

# ---------------------------------------------------------------------------
# Downloads
# ---------------------------------------------------------------------------
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3
# Extra requests that may wait in the queue before the API returns 503
MAX_QUEUE_LENGTH=20
# Bytes (default 2 GiB). 0 = unlimited.
MAX_FILE_SIZE=2147483648
# How long finished files stay on the server, in ms (default 1 hour)
FILE_TTL_MS=3600000
ANALYZE_TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=1800000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Window for both limits below, in ms (default 15 minutes)
RATE_LIMIT_WINDOW=900000
# Max API requests per IP per window
RATE_LIMIT_MAX_REQUESTS=300
# Max download requests per IP per window
DOWNLOAD_RATE_LIMIT_MAX=30
# Allow fetching URLs on private/internal networks. Keep false on public servers.
ALLOW_PRIVATE_NETWORKS=false
